# syntax=docker/dockerfile:1.7

FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY pkg ./pkg
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/agentbox-runner ./cmd/agentbox-runner \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/agentd ./cmd/agentd

FROM alpine:3.21
RUN apk add --no-cache ca-certificates git \
 && adduser -D -u 1000 agentbox
COPY --from=builder /out/agentbox-runner /usr/local/bin/agentbox-runner
COPY --from=builder /out/agentd /opt/agentbox/agentd
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/agentbox-runner"]
